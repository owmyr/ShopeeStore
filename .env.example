# --- LLM (local Ollama) ---
LLM_MODEL=qwen2.5:14b-instruct
LLM_HOST=http://localhost:11434

# --- Scraper ---
SCRAPE_MAX_PRODUCTS=500
SCRAPE_KEYWORD=camiseta estampada
SCRAPE_CATEGORY_URL=
SCRAPE_DELAY_MIN_SEC=3
SCRAPE_DELAY_MAX_SEC=6
SCRAPE_HEADLESS=true

# --- Scheduler (weekly deep run + daily pulse) ---
SCHEDULE_CRON_WEEKDAY=mon
SCHEDULE_CRON_HOUR=9
SCHEDULE_PULSE_HOUR=8

# --- Storage ---
DB_PATH=data/shopee.db
LEDGER_PATH=data/ledger.jsonl
SHOPEE_AUTH_PATH=data/shopee_auth.json
